# Copy to .env and fill in. No paid API keys are required by this project.

# Postgres with the pgvector extension available.
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/newsfeed?schema=public"

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Set true when self-hosting (anything other than Vercel).
AUTH_TRUST_HOST=true
